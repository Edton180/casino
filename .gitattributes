# Normalize text files
* text=auto eol=lf

# Common binary assets (avoid textual diff/merge)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.rar binary
*.7z binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# SQL dumps are often large snapshots; keep as raw text without eol conversion
*.sql -text
# Markdown should always be treated as text
*.md text diff=markdown
*.bat text eol=crlf
*.sh text eol=lf
