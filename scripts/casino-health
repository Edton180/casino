#!/usr/bin/env bash
# Verificação rápida: site respondendo, banco acessível e agendador
set -euo pipefail
APP_DIR="${APP_DIR:-/var/www/casino}"
cd "$APP_DIR"
php artisan about --only=environment
php artisan schedule:list
curl -s -o /dev/null -w "Site: HTTP %{http_code}\n" "$(grep -E '^APP_URL=' .env | cut -d= -f2-)"
